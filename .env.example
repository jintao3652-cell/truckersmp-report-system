SECRET_KEY=replace-with-a-long-random-value
ENVIRONMENT=production
AUTO_CREATE_DB=0
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/truckersmp_db?charset=utf8mb4
UPLOAD_FOLDER=/var/lib/truckersmp/uploads
VIDEO_FOLDER=/sdk/truckersmp-videos
MAX_CONTENT_LENGTH=2147483648
MAX_USER_STORAGE_BYTES=21474836480
FFPROBE_PATH=/usr/bin/ffprobe
REQUIRE_FFPROBE=1
MEDIA_ACCEL_REDIRECT=1
SESSION_COOKIE_SECURE=1
MAIL_PROVIDER=custom
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_BLOCK_SECONDS=900
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=10
UPLOAD_RATE_LIMIT_BLOCK_SECONDS=3600
UPLOAD_SESSION_EXPIRES_SECONDS=86400
UPLOAD_CHUNK_MAX_BYTES=16777216
SHARE_RATE_LIMIT_MAX_ATTEMPTS=120
SHARE_RATE_LIMIT_WINDOW_SECONDS=3600
SHARE_RATE_LIMIT_BLOCK_SECONDS=3600
METRICS_REQUIRE_AUTH=1
METRICS_TOKEN=replace-with-metrics-token
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_PREFIX=videos
MEDIA_PROCESSING_ASYNC=1
MEDIA_JOB_MAX_ATTEMPTS=3
RETENTION_POLICY=365
NOTIFY_WEBHOOK_URL=
NOTIFY_ADMIN_EMAIL=
SHARE_VIEW_NOTIFY_COOLDOWN_SECONDS=3600
DISK_ALERT_THRESHOLD=90
STORAGE_SIGNED_URL_SECONDS=900
REQUIRE_REAL_MIME=1
API_REQUIRE_BEARER=1
PUBLIC_BASE_URL=https://reports.cnrpg.top:8335
UPLOAD_BASE_URL=https://upload.cnrpg.top:17023
UPLOAD_CORS_ORIGIN=https://reports.cnrpg.top:8335
UPLOAD_ALLOW_SESSION=1
SESSION_COOKIE_DOMAIN=.cnrpg.top
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
