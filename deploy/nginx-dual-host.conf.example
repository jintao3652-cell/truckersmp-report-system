# Main website: reports.cnrpg.top:8335
server {
    listen 8335;
    server_name reports.cnrpg.top;
    location / { proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; proxy_pass http://127.0.0.1:8000; }
    location /protected-videos/ { internal; alias /sdk/truckersmp-videos/; }
}

# Upload API: upload.cnrpg.top:17023. It uses the same Flask app/database.
server {
    listen 17023;
    server_name upload.cnrpg.top;
    client_max_body_size 2048m;
    client_body_timeout 3600s;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    location /api/v1/uploads {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8000;
    }
}
